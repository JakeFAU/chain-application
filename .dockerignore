# Version control, automation, documentation, and editor metadata
.git/
.github/
.idea/
.vscode/
.DS_Store
*.code-workspace
*.swp
*.swo
AGENTS.md
README.md
docs/

# Never send environment or credential material to the builder.
.env
.env.*
secrets/
keys/
certs/private/
**/application_default_credentials.json
**/credentials.json
**/*-credentials.json
**/service-account*.json
**/gha-creds-*.json
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Repository-local tools and build/test artifacts
bin/
dist/
tmp/
go.work
go.work.sum
**/*.test
coverage/
profiles/
cover.out
coverage.out
cpu.out
mem.out
mutex.out
block.out
trace.out
**/*.prof
**/*.pprof
**/*.trace

# Local-only state and unrelated infrastructure artifacts
.local/
.superpowers/
.worktrees/
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/crash.log
**/crash.*.log
