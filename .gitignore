/dist/
/tmp/
*.test
*.exe
*.exe~
*.dll
*.so
*.dylib
go.work
go.work.sum

# Coverage, fuzz, trace, and profiling output
/coverage/
/profiles/
cover.out
coverage.out
cpu.out
mem.out
mutex.out
block.out
trace.out
*.prof
*.pprof
*.trace

# Local environment configuration
.env
.env.*
!.env.example

# Local database and agent scratch state
/.local/
/.superpowers/
/.worktrees/

# IDE and operating-system files
.DS_Store
.idea/
.vscode/
*.code-workspace
