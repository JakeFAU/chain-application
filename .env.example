# Copy this file to the ignored .env.local, then replace the password placeholder
# with a local-only value before using the database commands.
POSTGRES_DB=attribution_chain
POSTGRES_USER=attribution_chain
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://attribution_chain:replace-with-local-password@127.0.0.1:5432/attribution_chain?sslmode=disable
